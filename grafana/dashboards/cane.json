{
 "title": "CaneCCS ML Monitoring",
 "uid": "cane-ml",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Predictions per minute",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "rate(cane_predictions_total[1m])*60",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p95 latency (predict)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(cane_request_latency_seconds_bucket{endpoint=\"predict\"}[1m])) by (le))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Median predicted CCS",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(cane_predicted_ccs_bucket[2m])) by (le))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Brix drift (z-score)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "cane_brix_drift_zscore",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Invalid requests / min",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "rate(cane_prediction_errors_total[1m])*60",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Low-CCS batches (<9)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "cane_low_ccs_batches_total",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  }
 ]
}